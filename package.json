{
  "name": "culture-daq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:clean": "lsof -ti :3002 | xargs kill -9 2>/dev/null; rm -rf .next && HOSTNAME=127.0.0.1 next dev -p 3002",
    "dev:check": "curl -sf -o /dev/null http://localhost:3002/ && echo 'OK: localhost:3002' || echo 'FAIL: localhost:3002 — run npm run dev:clean'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx scripts/seed.ts",
    "seed:culture-events": "tsx --env-file=.env.local scripts/seed-culture-events.ts",
    "decay:culture-expectations": "tsx --env-file=.env.local scripts/decay-culture-expectations.ts",
    "test:expectation": "tsx --test src/lib/culture-intelligence/expectation.test.ts",
    "test:attention": "tsx --test src/lib/culture-intelligence/attention.test.ts",
    "test:price-v2": "tsx --test src/lib/culture-intelligence/price-v2.test.ts",
    "test:why-it-moved": "tsx --test src/lib/culture-intelligence/why-it-moved-v2.test.ts",
    "test:replay-lab": "tsx --test src/lib/culture-intelligence/replay-lab.test.ts",
    "rebalance:preview": "tsx --env-file=.env.local scripts/rebalance-market.ts",
    "rebalance:apply": "tsx --env-file=.env.local scripts/rebalance-market.ts --apply",
    "rebalance:backup": "tsx --env-file=.env.local scripts/backup-market-reset.ts",
    "rebalance:validate": "tsx --env-file=.env.local scripts/validate-market-reset.ts",
    "rebalance:validate-dry-run": "tsx --env-file=.env.local scripts/validate-market-reset-dry-run.ts",
    "rebalance:resume": "tsx --env-file=.env.local scripts/resume-market-reset.ts",
    "test:price-engine": "tsx --test src/lib/price-engine.test.ts",
    "test:player-reset": "tsx --test src/lib/player-reset.test.ts",
    "test:market-rebalance": "tsx --test src/lib/market-rebalance.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
