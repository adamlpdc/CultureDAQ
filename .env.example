# Supabase (same project for local + preview + production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron (set in Vercel dashboard — use different secrets per env if you prefer)
CRON_SECRET=generate-a-random-secret-string

# App URL — set per environment (see README Deployment section)
# Local (default dev port is 3002; 3000 also supported for Supabase redirects):
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_ENV=development

# Vercel Production (culturedaq.com):
# NEXT_PUBLIC_APP_URL=https://culturedaq.com
# NEXT_PUBLIC_APP_ENV=production

# Vercel Preview (staging branch) — leave NEXT_PUBLIC_APP_URL unset; VERCEL_URL is used automatically
# NEXT_PUBLIC_APP_ENV=staging
