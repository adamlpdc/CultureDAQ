# Supabase (same project for local + preview + production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron (set in Vercel dashboard — use different secrets per env if you prefer)
CRON_SECRET=generate-a-random-secret-string

# Image enrichment dry-run (optional — movies/TV search + live TMDB override fetch)
TMDB_API_KEY=

# App URL — set per environment (see README Deployment section)
# Local (default dev port is 3002; 3000 also supported for Supabase redirects):
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_ENV=development

# Isolated Culture Intelligence sandbox (disabled unless explicitly true)
FEATURE_CULTURE_INTELLIGENCE=false
FEATURE_CULTURE_INTELLIGENCE_V1=true
# AI suggestion discovery. Keep false until migration, approved sources and key are ready.
FEATURE_CULTURE_INTELLIGENCE_V2=false
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-5-mini
AI_DISCOVERY_INTERVAL_MINUTES=15
AI_DISCOVERY_MIN_CONFIDENCE=45
# Optional: use persisted sandbox rows instead of generated mock events
CULTURE_EVENTS_SOURCE=mock
EXPECTATION_MAX_SCORE=95
EXPECTATION_HALF_LIFE_HOURS=72
PRICE_V2_MAX_CHANGE_PERCENT=12

# One-time production market rebalance tooling (keep false until approved)
FEATURE_MARKET_REBALANCE=false

# Active production pricing path. Set false only for emergency legacy rollback.
MARKET_ENGINE_V2_ENABLED=true

# Vercel Production (culturedaq.com):
# NEXT_PUBLIC_APP_URL=https://culturedaq.com
# NEXT_PUBLIC_APP_ENV=production

# Vercel Preview (staging branch) — leave NEXT_PUBLIC_APP_URL unset; VERCEL_URL is used automatically
# NEXT_PUBLIC_APP_ENV=staging
